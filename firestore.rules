rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública, escritura solo desde el backend (Admin SDK).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Órdenes: se crean y actualizan únicamente desde las Functions (Admin
    // SDK, que no pasa por estas reglas). Un usuario logueado sí puede LEER
    // sus propios pedidos — se los identifica por email, no por userId,
    // porque el checkout es libre (no hace falta cuenta para comprar).
    match /orders/{orderId} {
      allow read: if request.auth != null && request.auth.token.email == resource.data.email;
      allow write: if false;
    }
  }
}
