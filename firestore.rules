rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Catálogo: lectura pública, escritura solo desde el backend (Admin SDK).
    match /products/{productId} {
      allow read: if true;
      allow write: if false;
    }

    // Órdenes: nadie lee/escribe directo desde el cliente.
    // Se crean y actualizan únicamente desde las Functions (Admin SDK,
    // que no pasa por estas reglas).
    match /orders/{orderId} {
      allow read, write: if false;
    }
  }
}
