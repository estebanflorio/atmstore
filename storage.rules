rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Previews del catálogo: públicas (baja resolución / con marca de agua).
    // {fileName=**} matchea cualquier profundidad — las subimos organizadas
    // por producto: previews/{productId}/1.jpg, previews/{productId}/2.jpg...
    // Escritura solo para administradores.
    match /previews/{fileName=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Archivos finales: nunca públicos para lectura — solo se acceden vía
    // signed URL generada por la Function después de verificar el pago.
    // Escritura solo para administradores (subir el .zip del producto).
    match /final/{fileName=**} {
      allow read: if false;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
